# 复制为 .env 后填写。不要把 .env 或 data 目录外发。
DEEPSEEK_API_KEY=
# 只在本机调试口播时填写。两项都有时，口播直接用这一对，不再向中转站要临时凭证。
# 正式安装留空。登录后的口播凭证由 token4u 签发，不写进本机数据库。
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_REGION=ap-shanghai
# 海外账号可改录音识别域名，例如 asr.intl.tencentcloudapi.com
# TENCENT_ASR_HOST=asr.tencentcloudapi.com
# 可选：覆盖数据目录（数据库、视频副本、导出文件）
# EVC_DATA_DIR=
# 可选：FFmpeg 不在 PATH 时指定可执行文件
# EVC_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# EVC_FFPROBE=C:\ffmpeg\bin\ffprobe.exe
# EVC_LOG_LEVEL=INFO
# 登录后自动使用的 token4u 分组。默认按名称解析，不写死编号。
# 分组「电商审核专属-bot创建」是专属分组（余额计费，1.8 倍，含口播）。
# 管理员要先把它分配给账号，用户令牌才能在可用分组里看到它。
# 留空则使用下面这个默认名称。
# EVC_RELAY_GROUP_NAME=电商审核专属-bot创建
# 名称对不上时才用的数字分组编号。编号还不确定，留空则只按名称解析。
# 该编号也必须出现在当前账号的可用分组里，否则会报错，不会改用其他分组。
# EVC_RELAY_GROUP_ID=
# 仅供开发演示。设为 1 时不调用模型，返回固定样例命中。
# EVC_MOCK=0
# 管理控制台：页面随安装包分发，/v1 请求原样转发到下面的云端后台，
# 数据仍然只存在云端。控制台用 8780 端口，和工具端的 8765 分开。
# EVC_ADMIN_SERVER_URL=https://admin.token4u.cc
# EVC_CONSOLE_PORT=8780
# 设为 0 时完全不启动控制台入口。
# EVC_CONSOLE=0
# 可选：设为 1 时在本机 http://127.0.0.1:8765/mcp 提供 agent 调用。默认关闭。
# 也可以在设置里保存 mcp_enabled，下次启动生效。设为 0 则强制关闭。
# EVC_MCP=0
